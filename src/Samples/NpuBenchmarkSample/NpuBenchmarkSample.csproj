<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ElBruno.LocalEmbeddings\ElBruno.LocalEmbeddings.csproj" />
    <!-- DirectML NPU runs in a separate process (DirectMLNpuWorker) to avoid
         native onnxruntime.dll conflicts: DirectML ORT ships a DML-enabled DLL,
         base ORT ships a vanilla DLL — only one can load per process. -->
    <ProjectReference Include="..\..\ElBruno.LocalEmbeddings.Npu.Qualcomm\ElBruno.LocalEmbeddings.Npu.Qualcomm.csproj" />
    <!-- Intel OpenVINO runs in a separate process (IntelNpuWorker) to avoid
         ORT version conflicts: DirectML uses ORT 1.24.x, OpenVINO uses ORT 1.21.x.
         Only one onnxruntime.dll can load per process. -->
    <PackageReference Include="System.Management" Version="10.0.5" />
  </ItemGroup>

</Project>


