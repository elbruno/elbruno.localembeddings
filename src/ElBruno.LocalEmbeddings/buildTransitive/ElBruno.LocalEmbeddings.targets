<Project>
  <!-- ElBruno.LocalEmbeddings on .NET Framework. .NET Framework does not load native libraries from runtimes/<rid>/native, and the props
       of Microsoft.ML.OnnxRuntime that copy onnxruntime.dll reach only the projects that reference it directly. This copies the native
       libraries of ONNX Runtime next to the application, for x64, AnyCPU without Prefer32Bit, and ARM64. ONNX Runtime 1.24 has no win-x86
       library: a 32-bit application cannot run the model. The files are the ones NuGet resolved for the target framework, when it resolved
       them for every runtime, so they follow the version the application resolved, its fallback folders and its IncludeAssets and
       ExcludeAssets. All in a target, so that
       PlatformTarget and Prefer32Bit have their final values. -->
  <Target Name="ElBrunoLocalEmbeddingsNativeLibraries" AfterTargets="ResolveAssemblyReferences" DependsOnTargets="GetCopyToOutputDirectoryItems"
          Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PropertyGroup>
      <_ElBrunoEmbeddingsPlatform>$(PlatformTarget)</_ElBrunoEmbeddingsPlatform>
      <_ElBrunoEmbeddingsPlatform Condition="'$(_ElBrunoEmbeddingsPlatform)' == ''">$(Platform)</_ElBrunoEmbeddingsPlatform>
      <_ElBrunoEmbeddingsRid Condition="'$(_ElBrunoEmbeddingsPlatform)' == 'x64' Or (('$(_ElBrunoEmbeddingsPlatform)' == 'AnyCPU' Or '$(_ElBrunoEmbeddingsPlatform)' == 'Any CPU' Or '$(_ElBrunoEmbeddingsPlatform)' == '') And '$(Prefer32Bit)' != 'true')">win-x64</_ElBrunoEmbeddingsRid>
      <_ElBrunoEmbeddingsRid Condition="'$(_ElBrunoEmbeddingsPlatform)' == 'ARM64'">win-arm64</_ElBrunoEmbeddingsRid>
    </PropertyGroup>
    <Error Condition="'$(_ElBrunoEmbeddingsRid)' == '' And ('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe')"
           Text="ElBruno.LocalEmbeddings on .NET Framework needs a 64-bit process: ONNX Runtime 1.24 has no win-x86 library. Set PlatformTarget to x64 or ARM64, or AnyCPU with Prefer32Bit false." />
    <ItemGroup Condition="'$(_ElBrunoEmbeddingsRid)' != ''">
      <_ElBrunoEmbeddingsNative Include="@(RuntimeTargetsCopyLocalItems)"
                                Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'Microsoft.ML.OnnxRuntime' And '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == '$(_ElBrunoEmbeddingsRid)' And '%(RuntimeTargetsCopyLocalItems.Extension)' == '.dll'" />
      <!-- With a RuntimeIdentifier, as the win-x86 that the SDK gives to an application without PlatformTarget before it moves it to AnyCPU,
           NuGet resolves only the files of that runtime: the folder of the version of the managed assembly. -->
      <_ElBrunoEmbeddingsManaged Include="@(ReferencePath)" Condition="'%(Filename)' == 'Microsoft.ML.OnnxRuntime'" />
    </ItemGroup>
    <PropertyGroup Condition="'$(_ElBrunoEmbeddingsRid)' != '' And '@(_ElBrunoEmbeddingsNative)' == '' And '$(RuntimeIdentifier)' != '$(_ElBrunoEmbeddingsRid)' And '$(RuntimeIdentifier)' != ''">
      <_ElBrunoEmbeddingsOnnxRuntime>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))microsoft.ml.onnxruntime\@(_ElBrunoEmbeddingsManaged->'%(NuGetPackageVersion)')\runtimes\$(_ElBrunoEmbeddingsRid)\native\</_ElBrunoEmbeddingsOnnxRuntime>
    </PropertyGroup>
    <ItemGroup Condition="'$(_ElBrunoEmbeddingsOnnxRuntime)' != ''">
      <_ElBrunoEmbeddingsNative Include="$(_ElBrunoEmbeddingsOnnxRuntime)onnxruntime.dll;$(_ElBrunoEmbeddingsOnnxRuntime)onnxruntime_providers_shared.dll"
                                Condition="Exists('$(_ElBrunoEmbeddingsOnnxRuntime)onnxruntime.dll')" />
    </ItemGroup>
    <Warning Condition="'$(_ElBrunoEmbeddingsOnnxRuntime)' != '' And !Exists('$(_ElBrunoEmbeddingsOnnxRuntime)onnxruntime.dll')"
             Text="ElBruno.LocalEmbeddings did not find onnxruntime.dll of $(_ElBrunoEmbeddingsRid) in $(_ElBrunoEmbeddingsOnnxRuntime): copy it next to the application." />
    <ItemGroup Condition="'$(_ElBrunoEmbeddingsRid)' != ''">
      <!-- Not over a file with the same name that the application already copies: its own, one of a referenced project, or the one of
           another package, as onnxruntime.dll of Microsoft.ML.OnnxRuntime.DirectML. -->
      <_ElBrunoEmbeddingsInOutput Include="@(AllItemsFullPathWithTargetPath->'%(TargetPath)')" />
      <_ElBrunoEmbeddingsInOutput Include="@(ReferenceCopyLocalPaths->'%(DestinationSubDirectory)%(Filename)%(Extension)')" Condition="'%(ReferenceCopyLocalPaths.FullPath)' != ''" />
      <_ElBrunoEmbeddingsInOutput Include="@(RuntimeTargetsCopyLocalItems->'%(Filename)%(Extension)')"
                                  Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' != 'Microsoft.ML.OnnxRuntime' And '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == '$(_ElBrunoEmbeddingsRid)'" />
    </ItemGroup>
    <PropertyGroup>
      <_ElBrunoEmbeddingsInOutputNames>;@(_ElBrunoEmbeddingsInOutput->ToLowerInvariant());</_ElBrunoEmbeddingsInOutputNames>
    </PropertyGroup>
    <ItemGroup>
      <_ElBrunoEmbeddingsNative Remove="@(_ElBrunoEmbeddingsNative)" Condition="$(_ElBrunoEmbeddingsInOutputNames.Contains($([System.String]::Copy(';%(Filename)%(Extension);').ToLowerInvariant())))" />
      <ReferenceCopyLocalPaths Include="@(_ElBrunoEmbeddingsNative)" DestinationSubDirectory="" />
    </ItemGroup>
  </Target>
</Project>
